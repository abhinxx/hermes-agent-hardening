#!/usr/bin/env bash
# Take back the last auto-commit: remote rewind + local uncommit.
#
#   hermes-autogit-undo [repo-path]
#
# Refuses to touch anything it did not create. Changes come back to the working
# tree uncommitted so you can fix and re-commit. Repeatable.

set -uo pipefail

REPO="${1:-$PWD}"
TRAILER="Shipped-by: hermes-autogit"

cd "$REPO" 2>/dev/null || { echo "not a directory: $REPO" >&2; exit 1; }

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "not a git repo: $REPO" >&2; exit 1; }

if ! git log -1 --format=%B | grep -qF "$TRAILER"; then
  echo "refusing: HEAD was not created by hermes-autogit." >&2
  echo "  $(git log -1 --oneline)" >&2
  exit 1
fi

SHA="$(git rev-parse HEAD)"
PARENT="$(git rev-parse HEAD^ 2>/dev/null || echo "")"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"

echo "undoing $(git log -1 --oneline)"

if [[ -z "$PARENT" ]]; then
  echo "refusing: HEAD is the initial commit; undo it by hand." >&2
  exit 1
fi

# Rewind the remote FIRST, and only when its tip still equals our commit.
if REMOTE_URL="$(git remote get-url origin 2>/dev/null)"; then
  REMOTE_TIP="$(git ls-remote origin "refs/heads/$BRANCH" 2>/dev/null | awk '{print $1}')"
  if [[ "$REMOTE_TIP" == "$SHA" ]]; then
    echo "rewinding origin/$BRANCH"
    git push --force-with-lease="$BRANCH:$SHA" origin "$PARENT:refs/heads/$BRANCH" -q || {
      echo "remote rewind failed; aborting before touching local history." >&2
      exit 1; }
  elif [[ -n "$REMOTE_TIP" && "$REMOTE_TIP" != "$PARENT" ]]; then
    echo "refusing: origin/$BRANCH has moved past this commit. Undo by hand." >&2
    exit 1
  fi
fi

git reset "$PARENT"
echo "done. changes are back in the working tree, uncommitted."
